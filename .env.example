# ---------------------------------------------------------------------------
# Application Spotify — https://developer.spotify.com/dashboard
# Ajoutez l'URL de redirection suivante dans les réglages de l'application :
#   https://<votre-domaine>/api/auth/callback/spotify
#   http://127.0.0.1:3000/api/auth/callback/spotify   (développement local)
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# NextAuth
# NEXTAUTH_SECRET : obligatoire en production. Générer avec `openssl rand -base64 32`
# NEXTAUTH_URL    : URL canonique du déploiement (auto-détectée sur Vercel,
#                   à renseigner impérativement sur tout autre hébergeur).
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# URL publique utilisée pour les metadata (Open Graph, sitemap, robots.txt).
# Optionnelle sur Vercel : l'URL de production du projet est utilisée par défaut.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
